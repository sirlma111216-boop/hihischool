{
  // 고교 아틀라스 — Cloudflare Workers (Static Assets + Worker API + D1)
  // Pages 설정과 섞지 않는다. 배포 흐름: GitHub → Workers Builds.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "highschool-atlas",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // /api/* 는 항상 Worker가 처리한다. 정적 자산보다 Worker를 먼저 실행한다.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "vars": {
    // 비밀이 아닌 공개 설정만 둔다. 키는 wrangler secret put 으로 넣는다.
    "APP_ENV": "production",
    "PUBLIC_API_RATE_LIMIT_PER_MIN": "120",
    "ADMIN_UPLOAD_MAX_BYTES": "5242880"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "highschool_atlas",
      // `wrangler d1 create highschool_atlas` 로 생성 (2026-10-17, APAC)
      "database_id": "59c54453-c684-4a05-a23d-c249efe2e8da",
      "migrations_dir": "migrations"
    }
  ],
  // R2 는 선택 사항이다. 원문 보관이 필요할 때만 주석을 풀고 bucket 을 만든다.
  // "r2_buckets": [{ "binding": "SOURCE_FILES", "bucket_name": "highschool-atlas-sources" }],
  "env": {
    "preview": {
      "name": "highschool-atlas-preview",
      "vars": { "APP_ENV": "preview", "PUBLIC_API_RATE_LIMIT_PER_MIN": "120", "ADMIN_UPLOAD_MAX_BYTES": "5242880" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "highschool_atlas_preview",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
