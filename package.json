{
  "name": "highschool-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "고교 아틀라스 — 서울 고등학교 교육과정·진학상담 워크스페이스",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply highschool_atlas --local",
    "db:migrate:remote": "wrangler d1 migrations apply highschool_atlas --remote",
    "db:seed:synthetic": "tsx scripts/db/seed-synthetic.ts",
    "db:reset:local": "tsx scripts/db/reset-local.ts",
    "ingest:neis": "tsx scripts/ingest/neis.ts",
    "ingest:schoolinfo": "tsx scripts/ingest/schoolinfo.ts",
    "docs:extract": "tsx scripts/docs/extract.ts",
    "docs:package": "tsx scripts/docs/package-review.ts",
    "docs:fixtures": "tsx scripts/docs/make-fixtures.ts",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "docs:package-matrix": "tsx scripts/docs/package-matrix.ts",
    "db:export-sql": "tsx scripts/db/export-sql.ts"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "jose": "^6.1.0",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^5.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@eslint/js": "^9.39.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.64.0",
    "@types/leaflet": "^1.9.17",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.0",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.2.0",
    "globals": "^17.0.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "pretendard": "^1.3.9",
    "sharp": "^0.35.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.151.0"
  }
}
